# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.arqivollp.com

# Contact form email delivery via Resend (https://resend.com).
# Without RESEND_API_KEY the form falls back to opening the visitor's email app.
RESEND_API_KEY=
CONTACT_TO_EMAIL=arqivollp@gmail.com
# Must be an address on a domain verified in Resend
CONTACT_FROM_EMAIL="Arqivo Website <no-reply@arqivollp.com>"
